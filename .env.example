# Every variable this stack reads, with no secret values.
#
#     cp .env.example .env
#     ./scripts/preflight.sh
#
# `.env` is git-ignored and must stay that way. A secret committed once stays
# committed: rotating it afterwards is the cheap half of the work, and rewriting
# history is the expensive half nobody enjoys.
#
# Generate each secret separately. Reusing one across two of these means one
# disclosure is two compromises:
#
#     openssl rand -base64 36
#
# **Three values have no default and the stack will not start without them**:
# AJ_ADMIN_TOKEN, POSTGRES_PASSWORD and RUNNER_WORK_DIR. Everything else below
# has a working default and is here to be read, not necessarily changed.


# -- The topology ------------------------------------------------------------

# Which services this host runs. `docs/INSTALL.md` describes the four
# arrangements; the default is everything on one machine.
#
#   edge,app,data,runner   one host, the whole product        (the default)
#   edge,app,data          the application host, Runners elsewhere
#   runner                 a Runner-only host
#   app,data               no bundled nginx; your own proxy in front
#
# `app` is both `client` and `server`; name them separately to run one without
# the other, which is useful while debugging and when updating one half.
#
# **`external-runner` is an addition to any of these rather than a fifth one.**
# Add it beside `runner` to forward some problems to an external judging system,
# or run it alone on a host of its own. It is left out here because it needs an
# account at that system -- see *The external Runner* below.
COMPOSE_PROFILES=edge,app,data,runner

# **Anchors the backup, update and cleanup schedule to the operator's clock.**
# 04:00 means 04:00 to whoever runs this machine. Passed to the containers so
# that a log line and the crontab agree about what time it is.
TZ=Europe/Warsaw


# -- The images --------------------------------------------------------------

REGISTRY=ghcr.io/algojudge

# **A moving major, and it carries no `v`.** A release tagged `v1.4.2` publishes
# the image tags `1.4.2`, `1.4`, `1` and `latest`. Staying on `1` takes patches
# and minors on the next `scripts/update.sh` and never a major; an installation
# that wants to decide every version writes `1.4.2` here.
#
# `latest` is not offered. An installation that changed version because somebody
# pulled is not a deployment.
SERVER_TAG=1
CLIENT_TAG=1

# The Runner tag also names its four language images -- `lang-gcc`,
# `lang-clang`, `lang-python`, `lang-pypy` -- which are built and released
# together with it.
RUNNER_TAG=1

# The External Runner has its own version and its own repository, so it has its
# own tag: it ships no language images and is released on its own schedule.
EXTERNAL_RUNNER_TAG=1

POSTGRES_TAG=18
NGINX_TAG=1.27-alpine


# -- The database ------------------------------------------------------------

POSTGRES_DB=algojudge
POSTGRES_USER=algojudge

# Required. No default anywhere, deliberately: an unset password here would
# otherwise start a database whose password is the empty string.
POSTGRES_PASSWORD=

# **Applies pending migrations when the Server starts.** On, because a
# self-hosted installation has no other way to get its schema -- there is no SDK
# in the image and no migrate command in `aj-admin`. The Server's own default is
# off; this is the installation saying yes.
#
# `scripts/update.sh` takes a backup before every update for this reason.
# Turning it off means applying migrations yourself before starting a new image,
# and a Server with anything pending refuses to start and says so.
MIGRATE_ON_START=true


# -- The administrator's way in ----------------------------------------------

# **Set this before the first start, or there is no way into the installation
# at all.** `/api/v1/admin/**` is closed while this is empty, and that includes
# the endpoint that sets the administrator's password -- which is otherwise
# twenty random characters that were never written down.
#
#     openssl rand -base64 36
#
# It is only ever used from inside the Server's container:
#
#     docker compose exec -it server aj-admin password
AJ_ADMIN_TOKEN=


# -- The network -------------------------------------------------------------

HTTP_PORT=80
HTTPS_PORT=443

# **Whose word the Server takes for a visitor's address.** It refuses to start
# without this: trusting every sender of `X-Forwarded-For` lets a visitor state
# their own address, and trusting only loopback records the proxy instead of the
# person. This names the Compose network the bundled nginx sits on.
#
# **Write a network address, not a host one.** `172.28.0.5/24` is refused at
# startup, by name, with the address it should have been.
#
# Running behind your own proxy instead (`COMPOSE_PROFILES` without `edge`):
# put that proxy's network here. Reached with no proxy at all: `none`.
TRUSTED_PROXY_NETWORKS=172.28.0.0/24

# Must agree with the line above. Change both together if it collides with
# something already on the host.
EDGE_SUBNET=172.28.0.0/24

# Where the two halves are published on the host, loopback only. Useful for
# `curl` and for a proxy of your own; not a way into `/admin`, which answers
# only on the Server container's own loopback interface.
SERVER_PORT=8080
CLIENT_PORT=8082

# **What the browser should ask for, not what the containers call each other.**
# `/` means "the origin this page came from", which is what the bundled nginx
# arranges -- one domain, application at `/` and API at `/api/v1`, and no CORS.
#
# Serving them from different origins: put the Server's public address here, and
# add the Client's origin to the Server's `AJ_Cors__AllowedOrigins`.
API_BASE_URL=/

# **Its mirror image: where a browser reaches the *application*.** Empty is
# right for the bundled arrangement, where both halves are one origin and the
# Server builds a same-origin address by adding nothing to it.
#
# Fill it in when the two are on different origins, or a sign-in through an
# identity provider ends at a bare `/activities` -- resolved against the API's
# origin, where it is a 404.
APP_BASE_URL=


# -- Storage -----------------------------------------------------------------

# Where uploaded files go: `postgres`, `filesystem` or `s3`.
#
# **`postgres` by default, because it makes one `pg_dump` a complete backup.**
# The other two are supported and each costs a second thing to back up in step
# with the database -- `scripts/backup.sh` will tell you rather than quietly
# producing a dump that restores to a broken installation.
STORAGE_KIND=postgres

# **Each is read only by the kind that needs it**, so the four below stay empty
# on the default and cost nothing. Until 2026-09-01 they were not here and not in
# `compose.yaml` either, which meant two of the three values above could not
# start: the Server refuses at startup, by name, when the kind it was given has
# no path or no bucket.

# `filesystem` only. A named volume inside the stack, so an uploaded file is not
# lost on the next `up -d`. **Back it up in step with the database** -- a dump
# alone no longer restores this installation, and `scripts/backup.sh` says so.
STORAGE_PATH=/var/lib/algojudge/objects

# `s3` only, and all four are required together. Any S3-compatible service.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=


# -- The Runner --------------------------------------------------------------

# **Required, and it must be an absolute path on the host.**
#
# The Runner asks the Docker daemon to mount this directory into each job
# container, so the daemon has to be able to open it -- and a path it cannot
# open produces an **empty directory** rather than an error, which means every
# submission runs against nothing and no test fails visibly. Relative paths are
# refused by `scripts/preflight.sh` for exactly that reason.
#
#     RUNNER_WORK_DIR=/srv/algojudge/runner-work
#
# **Make it yourself, and give it to uid 65532.** Compose creates a missing one
# as root, the Runner runs unprivileged, and every job then fails with
# `Permission denied (os error 13)` -- the same sentence a wrong DOCKER_GID
# produces, which is why `scripts/preflight.sh` checks both separately:
#
#     sudo mkdir -p /srv/algojudge/runner-work
#     sudo chown 65532:65532 /srv/algojudge/runner-work
RUNNER_WORK_DIR=

# The name this Runner registers under and appears as in the manager panel.
# **Each Runner needs a different one**, and its own identity volume.
RUNNER_NAME=runner-1

RUNNER_PROBLEM_TYPES=standard-io@1,output-only@1

# **Read once, at the first registration, and never again.** A Runner carries
# tags and so does the work, and they are paired when the two lists share at
# least one. Empty means the general pool; anything else takes this Runner out
# of it. Changing it later does nothing -- re-register instead.
RUNNER_TAGS=

# The group that owns `/var/run/docker.sock` on this host:
#
#     getent group docker | cut -d: -f3
#
# **The group rather than root.** The image runs unprivileged and should stay
# that way. Note what this is worth to whoever gets it: access to the Docker
# socket is equivalent to root on the host. `docs/OPERATIONS.md` says what
# follows from that and when to put Runners on a machine of their own.
DOCKER_GID=999

RUNNER_STOP_GRACE=300s
RUNNER_LOG=info

# **Only on a host with no `server` container** -- a Runner-only or an External
# Runner-only one. The public HTTPS address of the installation, with no path:
# `/api/v1` is appended for you. Both Runners read it.
# SERVER_URL=https://algojudge.example.org


# -- The external Runner -----------------------------------------------------

# **Off unless `external-runner` is in COMPOSE_PROFILES, and that is the point.**
# This Runner evaluates nothing itself: it signs in to somebody else's judging
# system under an account there, forwards the submission, and reports back the
# verdict that archive reached. Their compilers, their limits, their opinion.
#
# **Two things outside this file decide whether it is ever handed work**, and
# neither is a variable here:
#
#   * External judging is off until this installation turns it on. It is a row
#     in the database -- `instance.externalJudgingEnabled` in `preconfig/`
#     before the first start, or the manager panel afterwards. While it is off
#     the queue is simply empty and this Runner looks perfectly healthy.
#   * An administrator approves it in the panel, as they approve every Runner.
#     It waits, and there is no timeout.

# The name it registers under and appears as in the panel. **Not the same as
# RUNNER_NAME**: this is a second Runner with its own identity and its own
# approval, and two rows with one name is a row nobody can act on.
EXTERNAL_RUNNER_NAME=external-runner-1

# Which judging system. `uva` -- UVa Online Judge -- is the integration that
# exists; an unrecognised name is refused at startup rather than defaulted.
# **One process serves one judge**, so a second system is a second service.
EXTERNAL_JUDGE=uva

# **The account at that judging system. Required while this profile is active,
# and both ship empty.**
#
# Every submission this installation forwards is made under this one account and
# stays on it for good. That is a decision for whoever owns the account -- and
# when testing, submit something written to be wrong, so its record stays honest.
#
# They are not marked required in `compose.yaml`: Compose interpolates that whole
# file before it applies profiles, so a required marker would break every
# arrangement that never runs this service. `scripts/preflight.sh` refuses them
# instead, and only when this profile is on.
EXTERNAL_JUDGE_USERNAME=
EXTERNAL_JUDGE_PASSWORD=

# **Read once, at the first registration**, exactly as RUNNER_TAGS is. Empty is
# the general pool; naming a pool takes this Runner out of it.
EXTERNAL_RUNNER_TAGS=

# What it declares it evaluates. **Empty means the judge's own type** -- `uva@1`
# for the integration that exists -- which is almost always what you want. A
# typo here is silence rather than an error: the Server pairs a Runner with work
# by string equality, so one declaring a type nothing uses is handed nothing.
EXTERNAL_PROBLEM_TYPES=

EXTERNAL_RUNNER_LOG=info


# -- Backup ------------------------------------------------------------------

BACKUP_DIR=./backups

# How far back the history reaches. `minimal` ~2 weeks, `standard` ~2 months,
# `extended` ~4 months. The three counts below are set from it; write a value to
# pin one.
BACKUP_PRESET=standard
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=2

# **A count policy does not bound disk usage**, and the database grows with
# every uploaded file. Written by `scripts/preflight.sh` as 25% of the
# filesystem the backups live on if it is empty; never more than 50%.
BACKUP_MAX_TOTAL_GB=

# Never dropped, whatever the size budget says. If even this many will not fit,
# the run fails and makes no dump -- deleting a known good backup to attempt a
# new one is the worst thing a backup script can do.
BACKUP_MIN_KEEP=2

# Left free on the target filesystem after a dump.
BACKUP_FREE_SPACE_RESERVE_GB=10

# **Reads every block of the dump back, not just its header.** A custom-format
# archive keeps its table of contents at the front, so the cheap check every run
# does would pass on a file truncated half way through the data. This is the one
# that would not -- at the cost of a full decompression pass on every backup.
#
# Worth having while the database still fits in a coffee break. `restore.sh`
# onto a spare host is the real test either way, and nothing here replaces it.
BACKUP_VERIFY_FULL=false

# **How long a person who asked to be forgotten stays in the backups.**
# Deletion of an account is anonymization, and backups are not re-anonymized --
# a dump taken before it still carries the name. Keep this window no longer than
# the retention window the installation's privacy policy states, and say in that
# policy that backups exist. `docs/OPERATIONS.md` has the paragraph.


# -- Garbage collection ------------------------------------------------------

GC_TMP_RETENTION_DAYS=7

# **Only images this project has stopped using**, never a global prune: the host
# may run other things and `docker system prune` does not know that.
GC_PRUNE_IMAGES=true
