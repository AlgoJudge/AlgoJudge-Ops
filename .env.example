# Every variable this stack reads, with no secret values.
#
#     cp .env.example .env
#     ./scripts/preflight.sh
#
# `.env` is git-ignored and must stay that way: a secret committed once has to
# be rotated *and* cut out of the history.
#
# Generate each secret separately. Reusing one across two of these means one
# disclosure is two compromises:
#
#     openssl rand -base64 36
#
# **Three values have no default and the stack will not start without them**:
# AJ_ADMIN_TOKEN, POSTGRES_PASSWORD and RUNNER_WORK_DIR. Everything else below
# has a working default.


# -- The topology ------------------------------------------------------------

# Which services this host runs. `docs/INSTALL.md` describes the four
# arrangements; the default is everything on one machine.
#
#   edge,app,data,runner   one host, the whole product        (the default)
#   edge,app,data          the application host, Runners elsewhere
#   runner                 a Runner-only host
#   app,data               no bundled nginx; your own proxy in front
#
# `app` is both `client` and `server`; name them separately to run one without
# the other.
#
# **`external-runner` is an addition to any of these, not a fifth one.** It is
# left out because it needs an account at an external judging system -- see
# *The external Runner* below.
COMPOSE_PROFILES=edge,app,data,runner

# **Anchors the schedule to the operator's clock, and nothing else.**
# `scripts/install-cron.sh` writes it as `CRON_TZ`.
#
# **The containers do not get it, deliberately**: they log in UTC, which is what
# makes two machines' logs comparable.
TZ=Europe/Warsaw


# -- The images --------------------------------------------------------------

REGISTRY=ghcr.io/algojudge

# **A moving major, and it carries no `v`.** A release tagged `v0.4.2` publishes
# the image tags `0.4.2`, `0.4`, `0` and `latest`. Staying on `0` takes every
# later one on the next `scripts/update.sh`.
#
# Below 1.0 a minor is allowed to change what the one before it did, so `0`
# follows those too. An installation that wants only fixes writes `0.1`, and one
# that wants to decide every version writes `0.1.0`.
#
# `latest` is not offered: an installation must not change version because
# somebody pulled.
SERVER_TAG=0
CLIENT_TAG=0

# The Runner tag also names its four language images -- `lang-gcc`,
# `lang-clang`, `lang-python`, `lang-pypy` -- which are built and released
# together with it.
RUNNER_TAG=0

# Its own repository, so its own tag.
EXTERNAL_RUNNER_TAG=0

POSTGRES_TAG=18

# How much of each container's log is kept. The daemon left to itself keeps
# **no limit at all**, which ends with a full disk on the busiest day; these two
# are what stop that. `docker compose logs` can only show what is kept, so raise
# them before a long contest if you expect to diagnose one afterwards.
#
# The stack uses Docker's `local` driver, which compresses what it rotates — so
# five files of twenty megabytes cost far less disk than the number suggests.
# `docker logs` and `docker compose logs` read it unchanged; **a collector that
# tails `*-json.log` off the host filesystem does not**, and putting `json-file`
# back in `compose.yaml` is the answer if you run one.
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

# **The stable line, and stale is the failure mode to watch for here.** nginx
# numbers even minors stable and odd ones mainline. This was `1.27-alpine` until
# 2026-09-08: that branch reached end of life on 2025-06-24 and the tag was last
# built 2025-04-16, while pulling cleanly the whole time -- a tag that still
# resolves is not a tag anybody still maintains. Read the date, not the pull.
NGINX_TAG=1.30-alpine


# -- The database ------------------------------------------------------------

POSTGRES_DB=algojudge
POSTGRES_USER=algojudge

# Required, with no default anywhere: an unset password would otherwise start a
# database whose password is the empty string.
POSTGRES_PASSWORD=

# **Applies pending migrations when the Server starts.** On, because a
# self-hosted installation has no other way to get its schema -- there is no SDK
# in the image and no migrate command in `aj-admin`. The Server's own default is
# off.
#
# `scripts/update.sh` takes a backup before every update for this reason.
# Turning it off means applying migrations yourself before starting a new image,
# and a Server with anything pending refuses to start and says so.
MIGRATE_ON_START=true


# -- The administrator's way in ----------------------------------------------

# **Set this before the first start, or there is no way into the installation
# at all.** `/api/v1/admin/**` is closed while this is empty, and that includes
# the endpoint that sets the administrator's password -- which is otherwise
# twenty random characters that were never written down.
#
#     openssl rand -base64 36
#
# It is only ever used from inside the Server's container:
#
#     docker compose exec -it server aj-admin password
AJ_ADMIN_TOKEN=


# -- The network -------------------------------------------------------------

HTTP_PORT=80
HTTPS_PORT=443

# **Whose word the Server takes for a visitor's address.** It refuses to start
# without this: trusting every sender of `X-Forwarded-For` lets a visitor state
# their own address, and trusting only loopback records the proxy instead of the
# person. This names the Compose network the bundled nginx sits on.
#
# **Write a network address, not a host one.** `172.28.0.5/24` is refused at
# startup, by name, with the address it should have been.
#
# Running behind your own proxy instead (`COMPOSE_PROFILES` without `edge`):
# put that proxy's network here. Reached with no proxy at all: `none`.
TRUSTED_PROXY_NETWORKS=172.28.0.0/24

# Must agree with the line above. Change both together if it collides with
# something already on the host.
EDGE_SUBNET=172.28.0.0/24

# Where the two halves are published on the host, loopback only. Not a way into
# `/admin`, which answers only on the Server container's own loopback interface.
SERVER_PORT=8080
CLIENT_PORT=8082

# **What the browser should ask for, not what the containers call each other.**
# `/` means "the origin this page came from", which is what the bundled nginx
# arranges -- one domain, application at `/` and API at `/api/v1`, and no CORS.
#
# Serving them from different origins: put the Server's public address here, and
# add the Client's origin to the Server's `AJ_Cors__AllowedOrigins` -- which this
# stack does not set, so it goes in an overlay. `docs/INSTALL.md` shows one.
#
# **The two must be the same site**: the same registrable domain and the same
# scheme. `algojudge.example` with `api.algojudge.example` is one site and works.
# `algojudge.example` with `algojudge-api.other` is two, and then **nobody can
# sign in at all** -- the session cookie is `SameSite=Lax`, a browser refuses to
# keep it when the sign-in answer comes from another site, and the application
# sits on the login screen with no error anywhere. Measured 2026-09-06: the login
# answers `200` with a `Set-Cookie`, the browser keeps nothing, and the next
# request is `401`.
API_BASE_URL=/

# Its mirror image: where a browser reaches the **application**. Empty is right
# on one origin. On two, leaving it empty ends a federated sign-in at a bare
# `/activities`, resolved against the API's origin, where it is a 404.
APP_BASE_URL=


# -- Storage -----------------------------------------------------------------

# Where uploaded files go: `postgres`, `filesystem` or `s3`.
#
# **`postgres` by default, because it makes one `pg_dump` a complete backup.**
# The other two are supported and each costs a second thing to back up in step
# with the database -- `scripts/backup.sh` will tell you rather than quietly
# producing a dump that restores to a broken installation.
STORAGE_KIND=postgres

# Each is read only by the kind that needs it. The Server refuses at startup, by
# name, when one is missing.

# `filesystem` only, in a volume of its own. **Back it up in step with the
# database**: a dump alone no longer restores this installation.
STORAGE_PATH=/var/lib/algojudge/objects

# `s3` only, and all four are required together.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=


# -- The Runner --------------------------------------------------------------

# **Required, and it must be an absolute path on the host.**
#
# The Runner asks the Docker daemon to mount this directory into each job
# container, so the daemon has to be able to open it -- and a path it cannot
# open produces an **empty directory** rather than an error, which means every
# submission runs against nothing and no test fails visibly. Relative paths are
# refused by `scripts/preflight.sh` for exactly that reason.
#
#     RUNNER_WORK_DIR=/srv/algojudge/runner-work
#
# **Compose creating it is fine.** It makes a missing one as root, mode 0755,
# which is what this needs: the Runner writes here as root and every job
# container mounts it read-only and reads it as uid 65534. A directory locked
# down by hand fails the second half, and every job then reports
# `Permission denied (os error 13)`. `chown 65532:65532` also works and is not
# needed.
RUNNER_WORK_DIR=

# What the four Runners register under and appear as in the manager panel: this
# with `-1` to `-4` after it. One installation's Runners are told apart by the
# number; **a second host running Runners of its own needs a different prefix**,
# or the panel shows two rows called the same thing.
RUNNER_NAME_PREFIX=runner

# **Which processors each Runner may use, and this decides whether verdicts are
# trustworthy rather than how fast they arrive.** Empty -- the default -- lets
# the host's scheduler place every job, which is right until somebody divides
# the machine up deliberately.
#
# The rule is **one Runner per physical core, given both of that core's
# threads**. Two threads of one core share their caches, so a job moving between
# them costs nothing; two *different* Runners on one core take each other's
# execution units, and a program then spends more processor time than it should
# for the same work.
#
# Read the pairs from the machine rather than copying the example. On a host
# where cpu0's partner is cpu1:
#
#     RUNNER_1_CPUSET=0,1
#     RUNNER_2_CPUSET=2,3
#     RUNNER_3_CPUSET=4,5
#     RUNNER_4_CPUSET=6,7
#
# and `cat /sys/devices/system/cpu/cpu0/topology/thread_siblings_list` says
# whether that is true here: `0-1` on this kind of host, `0,8` on another, and
# the list above is exactly wrong on the second.
RUNNER_1_CPUSET=
RUNNER_2_CPUSET=
RUNNER_3_CPUSET=
RUNNER_4_CPUSET=

RUNNER_PROBLEM_TYPES=standard-io@1,output-only@1

# **Read once, at the first registration, and never again.** A Runner carries
# tags and so does the work, and they are paired when the two lists share at
# least one. Empty means the general pool; anything else takes this Runner out
# of it. Changing it later does nothing -- re-register instead.
RUNNER_TAGS=

# The group that owns `/var/run/docker.sock` on this host:
#
#     getent group docker | cut -d: -f3
#
# **It does not decide whether the Runner works.** The service runs as root --
# the cgroup tree it measures from has root's directories -- so the socket opens
# whatever groups it is in, and `preflight.sh` only warns when this is wrong. Set
# it correctly anyway: it is what the service would need if it ever ran
# unprivileged.
#
# Access to the Docker socket is equivalent to root on the host either way;
# `docs/OPERATIONS.md` says what follows from that and when to put Runners on a
# machine of their own.
DOCKER_GID=999

# How long a stop waits for the Server to answer the claims it is holding.
#
# A Runner may ask the Server to hold a `claim` open — see AJ_Poll__WaitSeconds
# in the Runner's own configuration — and a stop shorter than that wait turns
# every held request into a reset connection instead of an ordinary empty
# answer. Nothing is lost either way; the log is just louder. Raise this
# alongside the wait if you raise the wait — up to three hundred seconds, which
# is the Server's own ceiling and which a Runner asking for more refuses to
# start against rather than being clamped to.
SERVER_STOP_GRACE=40s

# How long Docker waits before killing a Runner.
#
# On `SIGTERM` the Runner stops the evaluation it is running, hands the job back
# so another Runner takes it at once, and clears the containers it started. That
# is seconds of work; the default leaves room for a slow answer from the Server.
# **Shortening this below what those calls take turns a stop into a kill**, and a
# killed Runner leaves its job to the lease -- ten minutes in which nobody
# judges that submission.
#
# **It no longer has to cover the poll.** Until 2026-09-04 a stop landing while
# the Server was holding a `claim` open waited the whole of `AJ_Poll__WaitSeconds`
# — twenty-five seconds shipped, three hundred at the ceiling — before anything
# was handed back, so a raised wait made a kill certain rather than unlikely. A
# stop now settles that request in two seconds and releases whatever comes back.
RUNNER_STOP_GRACE=30s
# How much the Server says. **`Warning` on purpose**: at `Information` it logs
# every SQL statement it runs, which measured 91-98% of everything a judging
# stack writes — over a gigabyte for a three-thousand-submission contest, on the
# same disk as the database.
#
# Set `Information` while diagnosing something, and put it back. Raise
# `LOG_MAX_SIZE` with it if you need the window to cover more than minutes.
SERVER_LOG=Warning

RUNNER_LOG=info

# **Only on a host with no `server` container** -- a Runner-only or an External
# Runner-only one. The public HTTPS address of the installation, with no path:
# `/api/v1` is appended for you. Both Runners read it.
# SERVER_URL=https://algojudge.example.org


# -- The external Runner -----------------------------------------------------

# **Off unless `external-runner` is in COMPOSE_PROFILES.** This Runner evaluates
# nothing: it forwards the submission to an external judging system and reports
# back that archive's verdict.
#
# **Two things outside this file decide whether it is ever handed work**, and
# while either is missing the queue is simply empty and the Runner looks healthy:
# external judging must be on for the installation
# (`instance.externalJudgingEnabled` in `preconfig/`, or the panel), and an
# administrator must approve this Runner as they approve every other.

# Not RUNNER_NAME: a second Runner, with its own identity and its own approval.
EXTERNAL_RUNNER_NAME=external-runner-1

# One process serves one judge; a second system is a second service. An
# unrecognised name is refused at startup rather than defaulted.
EXTERNAL_JUDGE=uva

# **The account at that judging system. Required while this profile is on.**
# Every forwarded submission is made under it and stays on it for good, so when
# testing, submit something written to be wrong.
#
# Not marked required in `compose.yaml`: Compose interpolates that file before it
# applies profiles, so a required marker would break every arrangement that never
# runs this service. `scripts/preflight.sh` refuses them instead.
EXTERNAL_JUDGE_USERNAME=
EXTERNAL_JUDGE_PASSWORD=

# Read once, at the first registration, as RUNNER_TAGS is. Empty is the general
# pool.
EXTERNAL_RUNNER_TAGS=

# Empty declares the judge's own type, which is almost always right. A typo is
# silence, not an error: the Server pairs by string equality.
EXTERNAL_PROBLEM_TYPES=

EXTERNAL_RUNNER_LOG=info

# How long a stop waits for it to hand its work back.
#
# **Twice RUNNER_STOP_GRACE, because it holds twenty times as much.** The
# sandboxing Runner gives back the one job it is running; this one gives back
# every submission the archive has not answered for yet, which is one call to
# the Server each. The ones it does not reach in time wait out their leases
# instead — ten minutes each, on a Runner that is already gone.
EXTERNAL_RUNNER_STOP_GRACE=60s


# -- Backup ------------------------------------------------------------------

BACKUP_DIR=./backups

# How far back the history reaches. `minimal` ~2 weeks, `standard` ~2 months,
# `extended` ~4 months. The three counts below are set from it; write a value to
# pin one.
BACKUP_PRESET=standard
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=2

# **A count policy does not bound disk usage**, and the database grows with
# every uploaded file. Written by `scripts/preflight.sh` as 25% of the
# filesystem the backups live on if it is empty; never more than 50%.
BACKUP_MAX_TOTAL_GB=

# Never dropped, whatever the size budget says. If even this many will not fit,
# the run fails and makes no dump rather than delete a known good backup to
# attempt a new one.
BACKUP_MIN_KEEP=2

# Left free on the target filesystem after a dump.
BACKUP_FREE_SPACE_RESERVE_GB=10

# **Reads every block of the dump back, not just its header.** A custom-format
# archive keeps its table of contents at the front, so the cheap check every run
# does would pass on a file truncated half way through the data. This is the one
# that would not -- at the cost of a full decompression pass on every backup.
#
# `restore.sh` onto a spare host is the real test either way, and nothing here
# replaces it.
BACKUP_VERIFY_FULL=false


# -- Garbage collection ------------------------------------------------------

GC_TMP_RETENTION_DAYS=7

# **Only images this project has stopped using**, never a global prune: the host
# may run other things and `docker system prune` does not know that.
GC_PRUNE_IMAGES=true
